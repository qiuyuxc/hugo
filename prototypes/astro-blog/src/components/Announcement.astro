---
import { readFileSync } from 'node:fs';
import { parse } from 'smol-toml';
import Icon from './Icon.astro';
const config = parse(readFileSync(new URL('../../../../hugo.toml', import.meta.url), 'utf8'));
const params = config.params as Record<string, unknown>;
const banner = params.siteBanner as { enable?: boolean; endpoint?: string; timeoutMs?: number };
---
<dialog class="announcement-dialog" id="announcement-dialog" aria-labelledby="announcement-title" data-endpoint={banner.enable ? banner.endpoint : ''} data-timeout={banner.timeoutMs || 5000}>
  <div class="announcement-top"><p class="eyebrow">A NOTE FROM KUKIE</p><button type="button" class="icon-button" data-dismiss-announcement aria-label="关闭公告" autofocus>×</button></div>
  <div class="announcement-stage">
    <div class="announcement-intro" aria-hidden="true"><div class="announcement-geometry"><span></span><span></span><i></i></div></div>
    <div class="announcement-body" data-announcement-body>
      <div class="announcement-symbol"><Icon name="book" size={28} /></div>
      <h2 id="announcement-title">站点公告</h2>
      <p class="announcement-content" data-announcement-content></p>
      <a class="text-link" data-announcement-link hidden target="_blank" rel="noreferrer">查看公告链接 <Icon name="diagonal" size={15} /></a>
      <div class="announcement-actions"><label><input type="checkbox" id="announcement-today" /> 今日不再弹出</label><button type="button" class="solid-button" data-dismiss-announcement>知道了</button></div>
    </div>
  </div>
</dialog>
