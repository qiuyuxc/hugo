---
import type { Post } from '../lib/posts';
import { postUrl, dateLabel, readTime } from '../lib/posts';
import Icon from './Icon.astro';
interface Props { post: Post; index?: number; }
const { post, index = 0 } = Astro.props;
---
<article class="post-row" data-post data-categories={JSON.stringify(post.data.categories)} data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(' ')}`.toLowerCase()}>
  <div class="post-copy">
    <div class="post-meta"><span class="category-label">{post.data.categories[0] ?? '随记'}</span><span class="meta-dot">·</span><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time>{index === 0 && <span class="new-label">最新</span>}</div>
    <h3><a href={postUrl(post)}>{post.data.title}</a></h3>
    <p class="post-excerpt">{post.data.description}</p>
    <div class="post-bottom"><span><Icon name="clock" size={13} /> 约 {readTime(post)} 分钟</span><span class="post-tags">{post.data.tags.slice(0, 2).map(tag => <a href={`/search/?q=${encodeURIComponent(tag)}`}>#{tag}</a>)}</span><a class="read-arrow" href={postUrl(post)} aria-label={`阅读：${post.data.title}`}><Icon name="arrow" size={18} /></a></div>
  </div>
  {post.data.cover && <a class="post-cover" href={postUrl(post)} tabindex="-1" aria-hidden="true"><img src={post.data.cover} alt="" width="320" height="200" loading="lazy" /></a>}
</article>
