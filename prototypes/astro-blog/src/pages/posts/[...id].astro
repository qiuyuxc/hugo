---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import Comments from '../../components/Comments.astro';
import { getPosts, dateLabel, readTime } from '../../lib/posts';
export async function getStaticPaths() {
  return (await getPosts()).map(post => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const sections = headings.filter(heading => heading.depth === 2);
---
<Base title={post.data.title} description={post.data.description} active="文章归档">
  <a class="article-back" href="/#notes"><Icon name="back" size={15} /> 回到笔记</a>
  <header class="article-header">
    <div class="post-meta"><a class="category-label" href={`/?category=${encodeURIComponent(post.data.categories[0] || 'all')}#notes`}>{post.data.categories[0] || '随记'}</a><span>·</span><span>技术实践</span></div>
    <h1>{post.data.title}</h1>
    <div class="article-byline"><img src="/hero/avatar.jpg" width="27" height="27" alt="" /><span>Kukie</span><span>·</span><time datetime={post.data.date.toISOString()}>{dateLabel(post.data.date)}</time><span>·</span><span>约 {readTime(post)} 分钟阅读</span></div>
  </header>
  <div class="article-grid">
    <div class="article-main">
      {post.data.cover && <img class="article-cover" src={post.data.cover} alt={post.data.title} width="1364" height="768" />}
      <article class="prose" id="article-body"><Content /></article>
      <div class="article-end"><p>感谢你读到这里。</p><a class="text-link" href="/#notes">继续翻翻 <Icon name="arrow" size={16} /></a></div>
      <div class="tag-cloud">{post.data.tags.map(tag => <a href={`/search/?q=${encodeURIComponent(tag)}`}>#{tag}</a>)}</div>
      <Comments />
    </div>
    <aside class="article-sidebar" aria-label="阅读导航">
      <div class="toc-wrap">
        {sections.length > 0 && <details class="article-toc" open><summary>本篇目录 <Icon name="chevron" size={15} /></summary><ol class="toc-list">{sections.map(section => <li><a href={`#${section.slug}`}>{section.text}</a></li>)}</ol></details>}
        <div class="reading-tools"><span>阅读字号</span><button id="font-smaller" aria-label="缩小正文字号">A−</button><button id="font-larger" aria-label="放大正文字号">A+</button><button id="back-top" aria-label="返回页面顶部">↑</button></div>
      </div>
    </aside>
  </div>
</Base>
